{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "components/**/*",
    "lib/**/*",
    "vite.config.ts",
    "vite.browser.config.ts",
    "test-consumer/**/*",
    "../../tests/browser/**/*.ts",
    "../../playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
