{
  "name": "@usebones/icons",
  "version": "0.0.1",
  "description": "Icon adapter for bones: semantic icon names with swappable icon sets (Lucide default, Hugeicons supported).",
  "license": "MIT",
  "homepage": "https://usebones.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigurdarson/bones.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "icons",
    "react",
    "lucide",
    "hugeicons"
  ]
}
